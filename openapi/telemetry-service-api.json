{
  "openapi": "3.0.3",
  "info": {
    "title": "Telemetry Service API",
    "version": "1.0.0",
    "description": "Сервис получения, хранения и агрегации телеметрии устройств. Предоставляет WebSocket для real-time данных."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/telemetry/{deviceId}": {
      "get": {
        "summary": "Get device telemetry",
        "description": "Получение исторической телеметрии устройства",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Начало периода (timestamp)",
            "schema": { "type": "integer" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Конец периода (timestamp)",
            "schema": { "type": "integer" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Количество записей",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Смещение для пагинации",
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Telemetry data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "type": "integer" },
                    "total": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "timestamp": { "type": "integer" },
                          "metrics": { "type": "object" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Device not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/telemetry/{deviceId}/aggregate": {
      "get": {
        "summary": "Get aggregated telemetry",
        "description": "Агрегированная телеметрия (среднее, мин, макс, сумма)",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Начало периода (timestamp)",
            "schema": { "type": "integer" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Конец периода (timestamp)",
            "schema": { "type": "integer" }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Интервал агрегации (1h, 6h, 1d, 1w)",
            "schema": { 
              "type": "string",
              "enum": ["1h", "6h", "1d", "1w"],
              "default": "1h"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated telemetry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "type": "integer" },
                    "interval": { "type": "string" },
                    "aggregates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "periodStart": { "type": "integer" },
                          "periodEnd": { "type": "integer" },
                          "avg": { "type": "number" },
                          "min": { "type": "number" },
                          "max": { "type": "number" },
                          "sum": { "type": "number" },
                          "count": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Device not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/telemetry/{deviceId}/latest": {
      "get": {
        "summary": "Get latest telemetry",
        "description": "Последние показания устройства",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest telemetry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "type": "integer" },
                    "timestamp": { "type": "integer" },
                    "metrics": { "type": "object" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Device not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/ws/telemetry/{deviceId}": {
      "get": {
        "summary": "WebSocket real-time telemetry",
        "description": "WebSocket подключение для получения телеметрии в реальном времени\n\n**Формат сообщений от сервера:**\n```json\n{\n  \"deviceId\": 1,\n  \"timestamp\": 1700000000,\n  \"metrics\": { \"temperature\": 23.5, \"humidity\": 60 }\n}\n```",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
            "101": {
                "description": "Switching to WebSocket protocol",
                "headers": {
                "Upgrade": {
                    "schema": { "type": "string", "example": "websocket" }
                },
                "Connection": {
                    "schema": { "type": "string", "example": "Upgrade" }
                }
                }
            },
            "401": {
                "description": "Unauthorized"
            },
            "404": {
                "description": "Device not found"
            }
            }
      }
    }
  }
}